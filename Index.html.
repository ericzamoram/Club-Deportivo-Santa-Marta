```html
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Club Deportivo Santa Marta - Recaudación de Cuotas Sociales</title>
    <!-- Web App & Mobile Optimization Meta Tags -->
    <meta name="theme-color" content="#046A38">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="CD Santa Marta">
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        clubGreen: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            200: '#bbf7d0',
                            500: '#10b981',
                            600: '#00875a',
                            700: '#046a38',
                            800: '#03522b',
                            900: '#023c1f',
                            950: '#012513',
                        },
                        clubGold: {
                            300: '#fde047',
                            400: '#facc15',
                            500: '#eab308',
                            gold: '#D4AF37',
                            lightGold: '#F3E5AB'
                        }
                    }
                }
            }
        }
    </script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <style>
        body { font-family: 'Inter', sans-serif; -webkit-tap-highlight-color: transparent; }
        @media print {
            .no-print { display: none !important; }
            .print-only { display: block !important; }
            body { background: white; color: black; }
        }
        /* Custom scrollbars */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; }
        ::-webkit-scrollbar-thumb { background: #00875a; border-radius: 4px; }
    </style>
</head>
<body class="bg-slate-100 min-h-screen text-slate-800 flex flex-col antialiased selection:bg-clubGreen-500 selection:text-white">

    <!-- Header Principal -->
    <header class="bg-clubGreen-900 text-white border-b-4 border-clubGold-gold shadow-md sticky top-0 z-40 no-print">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-wrap justify-between items-center gap-3">
            
            <!-- Brand & Editable Crest -->
            <div class="flex items-center space-x-3">
                <div class="w-12 h-14 shrink-0 drop-shadow-md cursor-pointer relative group" onclick="document.getElementById('crest-file-input').click()" title="Haz clic o toca para subir tu propia insignia o foto del club">
                    <div id="header-crest-container" class="w-full h-full flex items-center justify-center overflow-hidden rounded">
                        <!-- SVG Crest default template -->
                    </div>
                    <div class="absolute inset-0 bg-black/60 rounded flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity text-white text-[9px] text-center font-bold px-1 leading-tight">
                        Cambiar Logo
                    </div>
                </div>
                <input type="file" id="crest-file-input" accept="image/*" class="hidden" onchange="handleCrestUpload(event)">
                
                <div>
                    <h1 class="text-lg sm:text-xl font-black tracking-tight text-white leading-tight flex items-center gap-2">
                        Club Deportivo Santa Marta
                        <span class="text-[10px] bg-clubGold-gold text-slate-950 font-black px-2 py-0.5 rounded uppercase tracking-wide">1964</span>
                    </h1>
                    <p class="text-[11px] text-clubGreen-200 font-medium flex items-center gap-1">
                        <i data-lucide="shield-check" class="w-3.5 h-3.5 text-clubGreen-500"></i> Portal Oficial de Recaudación
                    </p>
                </div>
            </div>

            <!-- View Mode Switcher Buttons -->
            <div class="flex items-center bg-clubGreen-950 p-1 rounded-xl border border-clubGreen-800 w-full sm:w-auto justify-stretch">
                <button id="btn-view-member" onclick="switchView('member')" class="flex-1 sm:flex-none px-4 py-2 rounded-lg text-xs font-bold transition-all flex items-center justify-center space-x-2 bg-clubGreen-600 text-white shadow-sm">
                    <i data-lucide="user-check" class="w-4 h-4"></i>
                    <span>Portal Socio (En Línea)</span>
                </button>
                <button id="btn-view-admin" onclick="switchView('admin')" class="flex-1 sm:flex-none px-4 py-2 rounded-lg text-xs font-bold transition-all flex items-center justify-center space-x-2 text-clubGreen-200 hover:text-white">
                    <i data-lucide="shield" class="w-4 h-4"></i>
                    <span>Acceso Administrador</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-6 flex-1 w-full">

        <!-- ========================================== -->
        <!-- VIEW 1: MEMBER ONLINE PAYMENT PORTAL      -->
        <!-- ========================================== -->
        <section id="view-member" class="space-y-6">
            <!-- Hero Banner -->
            <div class="bg-gradient-to-r from-clubGreen-950 via-clubGreen-900 to-clubGreen-800 rounded-2xl p-5 sm:p-8 text-white shadow-xl flex flex-col md:flex-row justify-between items-center gap-6 border-2 border-clubGold-gold/40 relative overflow-hidden">
                <div class="flex items-center gap-4 sm:gap-6 z-10 w-full md:w-auto">
                    <div id="hero-crest-container" class="w-20 h-24 sm:w-24 sm:h-28 shrink-0 bg-white/10 p-2 rounded-2xl backdrop-blur-md border border-clubGold-gold/50 shadow-2xl flex items-center justify-center overflow-hidden">
                        <!-- Crest dynamically injected -->
                    </div>

                    <div class="space-y-1">
                        <span class="bg-clubGold-gold text-slate-950 border border-clubGold-300 text-[10px] px-2.5 py-0.5 rounded-full font-black uppercase tracking-wider inline-block">Fundado el 12 de Octubre de 1964</span>
                        <h2 class="text-xl sm:text-3xl font-black tracking-tight leading-tight">Paga tu Cuota Social en Línea</h2>
                        <p class="text-clubGreen-100 text-xs sm:text-sm">Mantén al día tu compromiso con el club. Notificación directa a WhatsApp y comprobante automático por correo.</p>
                    </div>
                </div>

                <!-- Price Badges -->
                <div class="flex sm:flex-col gap-3 w-full md:w-auto z-10">
                    <div class="bg-white/10 backdrop-blur-md p-3 sm:p-4 rounded-xl border border-white/20 text-center flex-1">
                        <span class="text-[10px] uppercase text-clubGreen-200 font-semibold block">Cuota Mensual</span>
                        <span class="text-xl sm:text-2xl font-black text-white" id="hero-display-monthly">$5.000 <span class="text-xs font-normal text-clubGreen-200">CLP</span></span>
                    </div>
                    <div class="bg-clubGold-gold/20 backdrop-blur-md p-3 sm:p-4 rounded-xl border border-clubGold-gold/60 text-center flex-1 relative">
                        <span class="absolute -top-2 right-2 bg-clubGold-gold text-slate-950 text-[9px] font-black px-1.5 py-0.5 rounded uppercase shadow">Ahorro Anual</span>
                        <span class="text-[10px] uppercase text-clubGold-lightGold font-bold block">Cuota Anual</span>
                        <span class="text-xl sm:text-2xl font-black text-white" id="hero-display-annual">$50.000 <span class="text-xs font-normal text-clubGold-lightGold">CLP</span></span>
                    </div>
                </div>
            </div>

            <!-- Flow Layout: Member Form + Checkout -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8">
                
                <!-- Left: Form Step 1 & 2 -->
                <div class="lg:col-span-7 bg-white rounded-2xl shadow-sm border border-slate-200 p-5 sm:p-8 space-y-6">
                    <div class="border-b border-slate-100 pb-4 flex justify-between items-center">
                        <div>
                            <h3 class="text-base sm:text-lg font-bold text-slate-900 flex items-center gap-2">
                                <span class="w-7 h-7 rounded-full bg-clubGreen-700 text-white text-xs flex items-center justify-center font-bold">1</span>
                                Datos del Socio
                            </h3>
                            <p class="text-xs text-slate-500 mt-0.5">Ingresa los datos para registrar el pago en el padrón.</p>
                        </div>
                        <button type="button" onclick="document.getElementById('crest-file-input').click()" class="text-xs bg-clubGreen-50 text-clubGreen-700 border border-clubGreen-300 font-semibold px-2.5 py-1.5 rounded-lg hover:bg-clubGreen-100 transition flex items-center gap-1.5">
                            <i data-lucide="upload" class="w-3.5 h-3.5"></i>
                            <span class="hidden sm:inline">Cambiar</span> Logo
                        </button>
                    </div>

                    <form id="member-form" onsubmit="event.preventDefault(); validateMemberForm();" class="space-y-4">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-bold text-slate-700 uppercase mb-1">RUT del Socio *</label>
                                <input type="text" id="member-rut" required placeholder="12.345.678-9" oninput="formatRut(this)" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-clubGreen-600 focus:border-clubGreen-600 text-sm font-semibold outline-none transition">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Nombre Completo *</label>
                                <input type="text" id="member-name" required placeholder="Juan Pérez Soto" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-clubGreen-600 focus:border-clubGreen-600 text-sm font-medium outline-none transition">
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Categoría *</label>
                                <select id="member-category" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-clubGreen-600 focus:border-clubGreen-600 text-sm font-medium outline-none transition bg-white">
                                    <option value="Adulto">Adulto</option>
                                    <option value="Cadetes">Cadetes</option>
                                    <option value="Infantil">Infantil</option>
                                    <option value="Juvenil">Juvenil</option>
                                    <option value="Senior">Senior</option>
                                    <option value="Super Senior">Super Senior</option>
                                    <option value="Honor">Socio de Honor</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Correo Electrónico *</label>
                                <input type="email" id="member-email" required placeholder="socio@ejemplo.com" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-clubGreen-600 focus:border-clubGreen-600 text-sm font-medium outline-none transition">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Teléfono Móvil *</label>
                                <input type="tel" id="member-phone" required placeholder="+56 9 1234 5678" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-clubGreen-600 focus:border-clubGreen-600 text-sm font-medium outline-none transition">
                            </div>
                        </div>

                        <!-- Step 2: Plan Selection -->
                        <div class="pt-4 border-t border-slate-100">
                            <h3 class="text-base sm:text-lg font-bold text-slate-900 flex items-center gap-2 mb-3">
                                <span class="w-7 h-7 rounded-full bg-clubGreen-700 text-white text-xs flex items-center justify-center font-bold">2</span>
                                Selecciona el Plan a Cancelar
                            </h3>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                                <label class="relative border-2 rounded-xl p-4 cursor-pointer transition-all flex flex-col justify-between plan-card border-clubGreen-600 bg-clubGreen-50/30" id="card-plan-monthly">
                                    <input type="radio" name="plan_type" value="mensual" checked onclick="selectPlan('mensual')" class="sr-only">
                                    <div>
                                        <div class="flex justify-between items-center mb-1">
                                            <span class="font-bold text-slate-900 text-sm">Cuota Mensual</span>
                                            <span class="w-5 h-5 rounded-full border-2 border-clubGreen-600 bg-clubGreen-600 flex items-center justify-center text-white font-bold text-xs" id="radio-dot-mensual">✓</span>
                                        </div>
                                        <p class="text-xs text-slate-500">Membresía activa por 1 mes calendario.</p>
                                    </div>
                                    <div class="mt-3 pt-2 border-t border-slate-200/60 text-lg sm:text-xl font-extrabold text-slate-900">
                                        <span id="plan-price-monthly-display">$5.000</span> <span class="text-xs font-normal text-slate-500">/ mes</span>
                                    </div>
                                </label>

                                <label class="relative border-2 border-slate-200 rounded-xl p-4 cursor-pointer hover:border-clubGreen-600 transition-all flex flex-col justify-between plan-card" id="card-plan-annual">
                                    <input type="radio" name="plan_type" value="anual" onclick="selectPlan('anual')" class="sr-only">
                                    <div>
                                        <div class="flex justify-between items-center mb-1">
                                            <span class="font-bold text-slate-900 text-sm">Cuota Anual</span>
                                            <span class="w-5 h-5 rounded-full border-2 border-slate-300 flex items-center justify-center text-transparent font-bold text-xs" id="radio-dot-anual">✓</span>
                                        </div>
                                        <p class="text-xs text-slate-500">Acceso completo 12 meses (Ahorro garantizado).</p>
                                    </div>
                                    <div class="mt-3 pt-2 border-t border-slate-200/60">
                                        <span class="text-lg sm:text-xl font-extrabold text-clubGreen-700" id="plan-price-annual-display">$50.000</span>
                                        <span class="text-xs font-normal text-slate-500"> / año</span>
                                    </div>
                                </label>
                            </div>
                        </div>

                        <div class="pt-2">
                            <button type="submit" class="w-full bg-clubGreen-700 hover:bg-clubGreen-800 text-white font-bold py-3.5 px-6 rounded-xl shadow-lg hover:shadow-clubGreen-700/20 transition duration-200 flex items-center justify-center space-x-2 text-sm sm:text-base">
                                <i data-lucide="shield-check" class="w-5 h-5"></i>
                                <span>Proceder con los Datos de Pago</span>
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Right: Step 3 Payment Details Box -->
                <div class="lg:col-span-5 bg-clubGreen-950 text-white rounded-2xl shadow-xl p-5 sm:p-7 flex flex-col justify-between border border-clubGreen-900 relative overflow-hidden">
                    <div>
                        <div class="flex justify-between items-center border-b border-clubGreen-900 pb-3 mb-5">
                            <h3 class="text-base font-bold text-white flex items-center gap-2">
                                <span class="w-7 h-7 rounded-full bg-clubGreen-600 text-white text-xs flex items-center justify-center font-bold">3</span>
                                Pago y Datos de Tesorería
                            </h3>
                            <span class="text-[10px] bg-clubGreen-800 text-clubGreen-200 font-mono px-2 py-0.5 rounded border border-clubGreen-700 flex items-center gap-1">
                                <span class="w-2 h-2 rounded-full bg-clubGreen-400 animate-pulse"></span> Verificado
                            </span>
                        </div>

                        <!-- Resumen del Pago Selected -->
                        <div class="bg-clubGreen-900/80 rounded-xl p-3.5 mb-5 border border-clubGreen-800 space-y-1.5">
                            <div class="text-[10px] text-clubGreen-300 font-bold uppercase tracking-wider">Resumen de Cuota a Pagar</div>
                            <div class="flex justify-between items-center text-sm">
                                <span class="text-slate-200 font-medium" id="summary-plan-title">Cuota Mensual</span>
                                <span class="font-extrabold text-white text-base" id="summary-plan-amount">$5.000 CLP</span>
                            </div>
                            <div class="flex justify-between items-center text-xs text-clubGreen-200 pt-1.5 border-t border-clubGreen-800/80">
                                <span>Titular Socio:</span>
                                <span id="summary-member-name" class="font-semibold text-white">Por completar...</span>
                            </div>
                        </div>

                        <!-- Bank Details Box Dynamic -->
                        <div class="bg-clubGreen-900 p-4 rounded-xl border border-clubGreen-800 space-y-2 text-xs mb-5 shadow-inner">
                            <div class="font-bold text-clubGold-300 uppercase tracking-wide flex items-center justify-between border-b border-clubGreen-800 pb-2">
                                <span class="flex items-center gap-1.5"><i data-lucide="landmark" class="w-4 h-4 text-clubGold-400"></i> Cuenta de Recaudación</span>
                                <span class="text-[9px] bg-clubGreen-700 px-2 py-0.5 rounded text-white font-mono" id="bank-name-tag">Mercado Pago</span>
                            </div>
                            <div class="flex justify-between"><span class="text-clubGreen-200">Titular:</span> <span class="font-semibold text-white" id="bank-holder-display">José Lepe Flores</span></div>
                            <div class="flex justify-between"><span class="text-clubGreen-200">RUT Titular:</span> <span class="font-mono font-bold text-white" id="bank-rut-display">11.521.090-4</span></div>
                            <div class="flex justify-between"><span class="text-clubGreen-200">Tipo Cuenta:</span> <span class="font-semibold text-white" id="bank-type-display">Cuenta Vista</span></div>
                            <div class="flex justify-between"><span class="text-clubGreen-200">N° Cuenta:</span> <span class="font-mono font-bold text-clubGold-300 text-sm" id="bank-number-display">1093318599</span></div>
                            <div class="flex justify-between border-t border-clubGreen-800/80 pt-1.5"><span class="text-clubGreen-200">Correo Notificación:</span> <span class="font-semibold text-white font-mono text-[11px]" id="bank-email-display">Jose.lepe.f@gmail.com</span></div>
                        </div>

                        <!-- Payment Method Toggle -->
                        <div class="space-y-2">
                            <label class="block text-[11px] font-bold uppercase tracking-wider text-clubGreen-300">Selecciona Método de Pago</label>
                            <div class="grid grid-cols-2 gap-2.5">
                                <button type="button" onclick="setOnlinePaymentMethod('transfer')" id="pay-tab-transfer" class="p-3 rounded-xl border-2 border-clubGreen-500 bg-clubGreen-900 font-semibold text-xs flex flex-col items-center justify-center gap-1.5 text-white transition shadow-sm">
                                    <i data-lucide="arrow-left-right" class="w-5 h-5 text-clubGreen-400"></i>
                                    <span>Transferencia Directa</span>
                                </button>
                                <button type="button" onclick="setOnlinePaymentMethod('webpay')" id="pay-tab-webpay" class="p-3 rounded-xl border border-clubGreen-900 bg-clubGreen-900/40 font-semibold text-xs flex flex-col items-center justify-center gap-1.5 text-clubGreen-300 hover:text-white transition">
                                    <i data-lucide="credit-card" class="w-5 h-5"></i>
                                    <span>Pasarela Webpay</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="mt-6 pt-3 border-t border-clubGreen-900">
                        <button type="button" onclick="executeOnlinePayment()" class="w-full bg-clubGreen-500 hover:bg-clubGreen-600 text-slate-950 font-black py-3.5 px-4 rounded-xl shadow-lg transition duration-200 flex items-center justify-center space-x-2 text-sm sm:text-base">
                            <i data-lucide="check-circle-2" class="w-5 h-5"></i>
                            <span id="btn-pay-text">Confirmar y Emitir Comprobante</span>
                        </button>
                        <p class="text-[10px] text-clubGreen-300 text-center mt-2.5 leading-tight">
                            Al confirmar se abrirá **WhatsApp** para notificar al número <strong class="text-white font-mono" id="bank-phone-display">+56964704432</strong> y se enviará copia a tu correo.
                        </p>
                    </div>
                </div>

            </div>

            <!-- Access Link to Admin Box -->
            <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm flex flex-col sm:flex-row justify-between items-center gap-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-clubGreen-100 text-clubGreen-700 flex items-center justify-center font-bold shrink-0">
                        <i data-lucide="user-cog" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h4 class="font-bold text-slate-900 text-sm">¿Eres tesorero o administrador de la aplicación?</h4>
                        <p class="text-xs text-slate-500">Ingresa al panel para cobrar cuotas en efectivo, ajustar valores de cuota y editar datos bancarios.</p>
                    </div>
                </div>
                <button onclick="switchView('admin')" class="w-full sm:w-auto px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-black text-white text-xs font-bold transition flex items-center justify-center gap-2 shrink-0">
                    <i data-lucide="lock" class="w-4 h-4"></i>
                    <span>Abrir Panel de Administración</span>
                </button>
            </div>
        </section>


        <!-- ========================================== -->
        <!-- VIEW 2: ADMINISTRATOR CASH COLLECTION PANEL-->
        <!-- ========================================== -->
        <section id="view-admin" class="hidden space-y-6">
            
            <!-- Admin Header Banner -->
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 bg-white p-5 sm:p-6 rounded-2xl shadow-sm border border-slate-200">
                <div class="flex items-center gap-4">
                    <div id="admin-crest-container" class="w-12 h-14 shrink-0 overflow-hidden flex items-center justify-center">
                        <!-- Crest -->
                    </div>
                    <div>
                        <span class="bg-clubGreen-800 text-white text-[10px] font-black px-2.5 py-0.5 rounded-md uppercase tracking-wider">Caja & Tesorería</span>
                        <h2 class="text-xl sm:text-2xl font-black text-slate-900 mt-0.5">Módulo de Administración del Club</h2>
                        <p class="text-xs text-slate-500">Recaudación presencial en efectivo, configuración de cuentas y métricas.</p>
                    </div>
                </div>
                <div class="flex flex-wrap gap-2 w-full md:w-auto">
                    <button onclick="openCashModal()" class="flex-1 md:flex-none bg-clubGreen-700 hover:bg-clubGreen-800 text-white px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm shadow-sm flex items-center justify-center space-x-2 transition">
                        <i data-lucide="banknote" class="w-4 h-4"></i>
                        <span>Cobrar en Efectivo (Caja)</span>
                    </button>
                    <button onclick="exportToCSV()" class="flex-1 md:flex-none bg-slate-800 hover:bg-slate-900 text-white px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm shadow-sm flex items-center justify-center space-x-2 transition">
                        <i data-lucide="download" class="w-4 h-4"></i>
                        <span>Exportar CSV</span>
                    </button>
                </div>
            </div>

            <!-- Statistics Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
                <div class="bg-white p-4 sm:p-5 rounded-2xl shadow-sm border border-slate-200">
                    <div class="text-[11px] font-bold text-slate-400 uppercase">Recaudación Total</div>
                    <div class="text-2xl sm:text-3xl font-black text-slate-900 mt-1" id="stat-total">$0</div>
                    <div class="text-xs text-slate-500 mt-2 flex items-center justify-between border-t pt-2">
                        <span>Ingresos Generales</span>
                        <i data-lucide="vault" class="w-4 h-4 text-slate-400"></i>
                    </div>
                </div>

                <div class="bg-white p-4 sm:p-5 rounded-2xl shadow-sm border border-slate-200 border-l-4 border-l-clubGreen-600">
                    <div class="text-[11px] font-bold text-slate-400 uppercase">Recaudado en Efectivo</div>
