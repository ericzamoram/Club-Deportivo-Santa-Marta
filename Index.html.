            localStorage.setItem('santa_marta_dues_db', JSON.stringify(state.transactions));
        }

        function saveSettingsToStorage() {
            localStorage.setItem('santa_marta_settings', JSON.stringify(state.settings));
        }

        // Apply SVG or Image to all logo containers
        function applyCrestToContainers(imgSrc) {
            const containers = ['header-crest-container', 'hero-crest-container', 'admin-crest-container', 'receipt-crest-container'];
            containers.forEach(id => {
                const el = document.getElementById(id);
                if(el) {
                    if(imgSrc) {
                        el.innerHTML = `<img src="${imgSrc}" class="w-full h-full object-contain drop-shadow-md" alt="Insignia Club Deportivo Santa Marta">`;
                    } else {
                        el.innerHTML = defaultCrestSVG;
                    }
                }
            });
        }

        // Handle Crest File Upload (Android / iOS Photo / File)
        function handleCrestUpload(event) {
            const file = event.target.files[0];
            if(!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                const base64Img = e.target.result;
                state.customCrestData = base64Img;
                localStorage.setItem('santa_marta_crest_img', base64Img);
                applyCrestToContainers(base64Img);
                showToast("Insignia del club actualizada correctamente en la app");
            };
            reader.readAsDataURL(file);
        }

        // View Switcher
        function switchView(view) {
            const memberSec = document.getElementById('view-member');
            const adminSec = document.getElementById('view-admin');
            const btnMember = document.getElementById('btn-view-member');
            const btnAdmin = document.getElementById('btn-view-admin');

            if(view === 'member') {
                memberSec.classList.remove('hidden');
                adminSec.classList.add('hidden');
                btnMember.className = "flex-1 sm:flex-none px-4 py-2 rounded-lg text-xs font-bold transition-all flex items-center justify-center space-x-2 bg-clubGreen-600 text-white shadow-sm";
                btnAdmin.className = "flex-1 sm:flex-none px-4 py-2 rounded-lg text-xs font-bold transition-all flex items-center justify-center space-x-2 text-clubGreen-200 hover:text-white";
            } else {
                memberSec.classList.add('hidden');
                adminSec.classList.remove('hidden');
                btnAdmin.className = "flex-1 sm:flex-none px-4 py-2 rounded-lg text-xs font-bold transition-all flex items-center justify-center space-x-2 bg-clubGreen-600 text-white shadow-sm";
                btnMember.className = "flex-1 sm:flex-none px-4 py-2 rounded-lg text-xs font-bold transition-all flex items-center justify-center space-x-2 text-clubGreen-200 hover:text-white";
                renderTable();
                updateStats();
            }
        }

        // Chilean RUT Formatter
        function formatRut(input) {
            let value = input.value.replace(/[^0-9kK]/g, '');
            if (value.length > 1) {
                let dv = value.slice(-1);
                let body = value.slice(0, -1);
                body = body.replace(/\B(?=(\d{3})+(?!\d))/g, ".");
                input.value = body + "-" + dv;
            } else {
                input.value = value;
            }
        }

        // Populate Admin Settings Inputs
        function populateSettingsForm() {
            document.getElementById('cfg-fee-monthly').value = state.settings.feeMonthly;
            document.getElementById('cfg-fee-annual').value = state.settings.feeAnnual;
            document.getElementById('cfg-bank-holder').value = state.settings.bankHolder;
            document.getElementById('cfg-bank-rut').value = state.settings.bankRut;
            document.getElementById('cfg-bank-name').value = state.settings.bankName;
            document.getElementById('cfg-bank-type').value = state.settings.bankType;
            document.getElementById('cfg-bank-number').value = state.settings.bankNumber;
            document.getElementById('cfg-bank-email').value = state.settings.bankEmail;
            document.getElementById('cfg-bank-phone').value = state.settings.bankPhone;
        }

        // Save Treasury Settings
        function saveTreasurySettings() {
            state.settings.feeMonthly = parseInt(document.getElementById('cfg-fee-monthly').value) || 5000;
            state.settings.feeAnnual = parseInt(document.getElementById('cfg-fee-annual').value) || 50000;
            state.settings.bankHolder = document.getElementById('cfg-bank-holder').value;
            state.settings.bankRut = document.getElementById('cfg-bank-rut').value;
            state.settings.bankName = document.getElementById('cfg-bank-name').value;
            state.settings.bankType = document.getElementById('cfg-bank-type').value;
            state.settings.bankNumber = document.getElementById('cfg-bank-number').value;
            state.settings.bankEmail = document.getElementById('cfg-bank-email').value;
            state.settings.bankPhone = document.getElementById('cfg-bank-phone').value;

            saveSettingsToStorage();
            updateUIWithSettings();
            showToast("Configuración de Tesorería guardada con éxito");
        }

        // Update UI displays dynamically
        function updateUIWithSettings() {
            const fmtMonthly = '$' + state.settings.feeMonthly.toLocaleString('es-CL');
            const fmtAnnual = '$' + state.settings.feeAnnual.toLocaleString('es-CL');

            document.getElementById('hero-display-monthly').innerHTML = `${fmtMonthly} <span class="text-xs font-normal text-clubGreen-200">CLP</span>`;
            document.getElementById('hero-display-annual').innerHTML = `${fmtAnnual} <span class="text-xs font-normal text-clubGold-lightGold">CLP</span>`;
            
            document.getElementById('plan-price-monthly-display').textContent = fmtMonthly;
            document.getElementById('plan-price-annual-display').textContent = fmtAnnual;

            document.getElementById('bank-holder-display').textContent = state.settings.bankHolder;
            document.getElementById('bank-rut-display').textContent = state.settings.bankRut;
            document.getElementById('bank-name-tag').textContent = state.settings.bankName;
            document.getElementById('bank-type-display').textContent = state.settings.bankType;
            document.getElementById('bank-number-display').textContent = state.settings.bankNumber;
            document.getElementById('bank-email-display').textContent = state.settings.bankEmail;
            document.getElementById('bank-phone-display').textContent = state.settings.bankPhone;

            selectPlan(state.selectedPlan);
            updateCashAmountHint();
        }

        // Select Plan
        function selectPlan(plan) {
            state.selectedPlan = plan;
            const cardMensual = document.getElementById('card-plan-monthly');
            const cardAnual = document.getElementById('card-plan-annual');
            const dotMensual = document.getElementById('radio-dot-mensual');
            const dotAnual = document.getElementById('radio-dot-anual');
            const titleSummary = document.getElementById('summary-plan-title');
            const amountSummary = document.getElementById('summary-plan-amount');

            const currentPrice = plan === 'mensual' ? state.settings.feeMonthly : state.settings.feeAnnual;
            const formattedPrice = '$' + currentPrice.toLocaleString('es-CL') + ' CLP';

            if(plan === 'mensual') {
                cardMensual.className = "relative border-2 rounded-xl p-4 cursor-pointer transition-all flex flex-col justify-between plan-card border-clubGreen-600 bg-clubGreen-50/30";
                cardAnual.className = "relative border-2 border-slate-200 rounded-xl p-4 cursor-pointer hover:border-clubGreen-600 transition-all flex flex-col justify-between plan-card";
                dotMensual.className = "w-5 h-5 rounded-full border-2 border-clubGreen-600 bg-clubGreen-600 flex items-center justify-center text-white font-bold text-xs";
                dotAnual.className = "w-5 h-5 rounded-full border-2 border-slate-300 flex items-center justify-center text-transparent font-bold text-xs";
                titleSummary.textContent = "Cuota Social Mensual";
            } else {
                cardAnual.className = "relative border-2 rounded-xl p-4 cursor-pointer transition-all flex flex-col justify-between plan-card border-clubGreen-600 bg-clubGreen-50/30";
                cardMensual.className = "relative border-2 border-slate-200 rounded-xl p-4 cursor-pointer hover:border-clubGreen-600 transition-all flex flex-col justify-between plan-card";
                dotAnual.className = "w-5 h-5 rounded-full border-2 border-clubGreen-600 bg-clubGreen-600 flex items-center justify-center text-white font-bold text-xs";
                dotMensual.className = "w-5 h-5 rounded-full border-2 border-slate-300 flex items-center justify-center text-transparent font-bold text-xs";
                titleSummary.textContent = "Cuota Social Anual";
            }

            amountSummary.textContent = formattedPrice;
        }

        // Toggle Payment Method
        function setOnlinePaymentMethod(method) {
            state.onlineMethod = method;
            const tabTransfer = document.getElementById('pay-tab-transfer');
            const tabWebpay = document.getElementById('pay-tab-webpay');

            if(method === 'transfer') {
                tabTransfer.className = "p-3 rounded-xl border-2 border-clubGreen-500 bg-clubGreen-900 font-semibold text-xs flex flex-col items-center justify-center gap-1.5 text-white transition shadow-sm";
                tabWebpay.className = "p-3 rounded-xl border border-clubGreen-900 bg-clubGreen-900/40 font-semibold text-xs flex flex-col items-center justify-center gap-1.5 text-clubGreen-300 hover:text-white transition";
            } else {
                tabWebpay.className = "p-3 rounded-xl border-2 border-clubGreen-500 bg-clubGreen-900 font-semibold text-xs flex flex-col items-center justify-center gap-1.5 text-white transition shadow-sm";
                tabTransfer.className = "p-3 rounded-xl border border-clubGreen-900 bg-clubGreen-900/40 font-semibold text-xs flex flex-col items-center justify-center gap-1.5 text-clubGreen-300 hover:text-white transition";
            }
        }

        function validateMemberForm() {
            const name = document.getElementById('member-name').value;
            if(!name) {
                showToast("Por favor ingresa tu nombre completo", "error");
                return;
            }
            document.getElementById('summary-member-name').textContent = name;
            showToast("Datos de socio confirmados. Procede al pago.");
        }

        // Execute Online Payment
        function executeOnlinePayment() {
            const rut = document.getElementById('member-rut').value;
            const name = document.getElementById('member-name').value;
            const category = document.getElementById('member-category').value;
            const email = document.getElementById('member-email').value;

            if(!rut || !name || !email) {
                showToast("Por favor completa los datos obligatorios del socio", "error");
                return;
            }

            const amount = state.selectedPlan === 'mensual' ? state.settings.feeMonthly : state.settings.feeAnnual;
            const concept = state.selectedPlan === 'mensual' ? 'Cuota Social Mensual' : 'Cuota Social Anual';
            const folio = 'SM-' + Math.floor(1000 + Math.random() * 9000);
            const dateStr = new Date().toLocaleString('es-CL');
            const method = state.onlineMethod === 'transfer' ? 'Transferencia' : 'Webpay';

            const newTx = {
                folio: folio,
                date: dateStr,
                rut: rut,
                name: name,
                category: category,
                concept: concept,
                amount: amount,
                method: method,
                status: 'Pagado'
            };

            state.transactions.unshift(newTx);
            saveData();
            showReceiptModal(newTx);

            // Trigger WhatsApp Native App
            const rawPhone = state.settings.bankPhone.replace(/[^0-9]/g, '');
            const message = `Hola Club Deportivo Santa Marta 👋, envío el comprobante de mi pago de cuota social:\n\n- Folio: #${folio}\n- RUT: ${rut}\n- Socio: ${name}\n- Categoría: ${category}\n- Concepto: ${concept}\n- Monto: $${amount.toLocaleString('es-CL')} CLP (${method})\n- Correo socio: ${email}\n- Fecha: ${dateStr}\n\nNotificación enviada a ${state.settings.bankEmail}. ¡Arriba Santa Marta! ⚽`;
            const encodedMsg = encodeURIComponent(message);
            
            showToast("Pago registrado. Abriendo WhatsApp de Tesorería...");
            setTimeout(() => {
                window.open(`https://wa.me/${rawPhone}?text=${encodedMsg}`, '_blank');
            }, 800);

            document.getElementById('member-form').reset();
            document.getElementById('summary-member-name').textContent = "Por completar...";
        }

        // Cash Admin Payment Submit
        function submitCashPayment() {
            const rut = document.getElementById('cash-rut').value;
            const name = document.getElementById('cash-name').value;
            const category = document.getElementById('cash-category').value;
            const plan = document.getElementById('cash-plan').value;
            const period = document.getElementById('cash-period').value;

            if(!rut || !name || !period) {
                showToast("Por favor completa todos los campos del formulario", "error");
                return;
            }

            const amount = plan === 'mensual' ? state.settings.feeMonthly : state.settings.feeAnnual;
            const concept = plan === 'mensual' ? `Cuota Mensual (${period})` : `Cuota Anual (${period})`;
            const folio = 'SM-' + Math.floor(1000 + Math.random() * 9000);
            const dateStr = new Date().toLocaleString('es-CL');

            const newTx = {
                folio: folio,
                date: dateStr,
                rut: rut,
                name: name,
                category: category,
                concept: concept,
                amount: amount,
                method: 'Efectivo',
                status: 'Pagado'
            };

            state.transactions.unshift(newTx);
            saveData();
            closeCashModal();
            renderTable();
            updateStats();
            showReceiptModal(newTx);
            showToast("Pago en efectivo registrado e ingresado a caja");
        }

        function updateCashAmountHint() {
            const plan = document.getElementById('cash-plan').value;
            const amount = plan === 'mensual' ? state.settings.feeMonthly : state.settings.feeAnnual;
            document.getElementById('cash-amount-display').textContent = '$' + amount.toLocaleString('es-CL') + ' CLP';
        }

        // Show Printable Receipt Modal
        function showReceiptModal(tx) {
            document.getElementById('rec-folio').textContent = '#' + tx.folio;
            document.getElementById('rec-date').textContent = tx.date;
            document.getElementById('rec-rut').textContent = tx.rut;
            document.getElementById('rec-name').textContent = tx.name;
            document.getElementById('rec-cat').textContent = tx.category;
            document.getElementById('rec-concept').textContent = tx.concept;
            document.getElementById('rec-method').textContent = tx.method;
            document.getElementById('rec-total').textContent = '$' + tx.amount.toLocaleString('es-CL') + ' CLP';

            // WhatsApp link button inside receipt
            const rawPhone = state.settings.bankPhone.replace(/[^0-9]/g, '');
            const message = `Hola Club Deportivo Santa Marta 👋, envío el comprobante de pago de cuota social:\n\n- Folio: #${tx.folio}\n- RUT: ${tx.rut}\n- Socio: ${tx.name}\n- Concepto: ${tx.concept}\n- Monto: $${tx.amount.toLocaleString('es-CL')} CLP (${tx.method})\n- Fecha: ${tx.date}\n\nGracias.`;
            const encodedMsg = encodeURIComponent(message);
            document.getElementById('whatsapp-share-btn').href = `https://wa.me/${rawPhone}?text=${encodedMsg}`;

            document.getElementById('receipt-modal').classList.remove('hidden');
        }

        function closeReceiptModal() {
            document.getElementById('receipt-modal').classList.add('hidden');
        }

        function openCashModal() {
            document.getElementById('cash-modal').classList.remove('hidden');
        }

        function closeCashModal() {
            document.getElementById('cash-modal').classList.add('hidden');
        }

        // Render Table (Admin)
        function renderTable() {
            const tbody = document.getElementById('transactions-table-body');
            const search = document.getElementById('filter-search').value.toLowerCase();
            const methodFilter = document.getElementById('filter-method').value;

            const filtered = state.transactions.filter(tx => {
                const matchesSearch = tx.rut.toLowerCase().includes(search) || tx.name.toLowerCase().includes(search);
                const matchesMethod = methodFilter === 'ALL' || tx.method === methodFilter;
                return matchesSearch && matchesMethod;
            });

            if(filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="text-center py-8 text-slate-400">No hay registros de cuotas sociales para mostrar.</td></tr>`;
                return;
            }

            tbody.innerHTML = filtered.map(tx => `
                <tr class="hover:bg-slate-50/80 transition">
                    <td class="p-3.5">
                        <div class="font-bold font-mono text-slate-900">#${tx.folio}</div>
                        <div class="text-[10px] text-slate-400">${tx.date}</div>
                    </td>
                    <td class="p-3.5">
                        <div class="font-bold text-slate-900">${tx.name}</div>
                        <div class="text-[10px] text-slate-500 font-mono">${tx.rut}</div>
                    </td>
                    <td class="p-3.5">
                        <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 text-[10px] font-bold">${tx.category}</span>
                    </td>
                    <td class="p-3.5 text-slate-600">${tx.concept}</td>
                    <td class="p-3.5 font-black text-slate-900">$${tx.amount.toLocaleString('es-CL')}</td>
                    <td class="p-3.5">
                        <span class="px-2 py-0.5 rounded-lg text-[10px] font-bold ${
                            tx.method === 'Efectivo' ? 'bg-clubGreen-100 text-clubGreen-800 border border-clubGreen-300' :
                            tx.method === 'Webpay' ? 'bg-emerald-100 text-emerald-800 border border-emerald-300' : 'bg-teal-100 text-teal-800 border border-teal-300'
                        }">
                            ${tx.method}
                        </span>
                    </td>
                    <td class="p-3.5 text-center">
                        <button onclick='showReceiptModal(${JSON.stringify(tx)})' title="Ver Recibo" class="p-1.5 text-slate-600 hover:text-clubGreen-700 hover:bg-clubGreen-50 rounded-lg transition">
                            <i data-lucide="file-text" class="w-4 h-4"></i>
                        </button>
                    </td>
                </tr>
            `).join('');

            lucide.createIcons();
        }

        // Update Statistics
        function updateStats() {
            let total = 0;
            let cash = 0;
            let electronic = 0;
            const uniqueMembers = new Set();

            state.transactions.forEach(tx => {
                total += tx.amount;
                if(tx.method === 'Efectivo') {
                    cash += tx.amount;
                } else {
                    electronic += tx.amount;
                }
                uniqueMembers.add(tx.rut);
            });

            document.getElementById('stat-total').textContent = '$' + total.toLocaleString('es-CL');
            document.getElementById('stat-cash').textContent = '$' + cash.toLocaleString('es-CL');
            document.getElementById('stat-electronic').textContent = '$' + electronic.toLocaleString('es-CL');
            document.getElementById('stat-members-count').textContent = uniqueMembers.size;
        }

        // Export CSV File
        function exportToCSV() {
            let csv = "\uFEFF"; // UTF-8 BOM
            csv += "Folio,Fecha,RUT,Nombre,Categoria,Concepto,Monto,MedioPago,Estado\n";
            state.transactions.forEach(tx => {
                csv += `"${tx.folio}","${tx.date}","${tx.rut}","${tx.name}","${tx.category}","${tx.concept}",${tx.amount},"${tx.method}","${tx.status}"\n`;
            });

            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement("a");
            const url = URL.createObjectURL(blob);
            link.setAttribute("href", url);
            link.setAttribute("download", `Cuotas_CD_Santa_Marta_${new Date().toISOString().slice(0,10)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            showToast("Planilla CSV descargada con éxito");
        }

        // Toast Message System
        function showToast(msg, type = "success") {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toast-message');
            const toastIcon = document.getElementById('toast-icon');

            toastMsg.textContent = msg;
            if(type === "error") {
                toastIcon.setAttribute('data-lucide', 'alert-circle');
                toastIcon.className = "w-5 h-5 text-red-400";
            } else {
                toastIcon.setAttribute('data-lucide', 'check-circle');
                toastIcon.className = "w-5 h-5 text-clubGreen-400";
            }
            lucide.createIcons();

            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3200);
        }
    </script>
</body>
